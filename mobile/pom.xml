<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.muenchen.ataf</groupId>
        <artifactId>agile-test-automation-framework</artifactId>
        <version>0.3.5-SNAPSHOT</version>
    </parent>

    <artifactId>mobile</artifactId>
    <name>Agile Test Automation Framework - Mobile</name>
    <description>Appium-based automation of native Android apps (UiAutomator2) for ATAF Cucumber scenarios</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>de.muenchen.ataf</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/io.appium/java-client -->
        <!-- 11.x requires Appium server 3+ and only depends on selenium-api (range [4.50.0,5.0)). -->
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>11.0.0</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-api -->
        <!-- Pins the open version range of java-client to the Selenium version used by the web module. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-api</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.mockito/mockito-core -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
